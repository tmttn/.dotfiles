[user]
	name = Tom Metten
	email = tom.metten@acagroup.be  # ACA work email for macOS laptops
	signingkey = E6287717D24A595A  # ACA GPG key
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[commit]
	gpgsign = true
[core]
	autocrlf = input
[push]
	autoSetupRemote = true
[gpg]
	program = /opt/homebrew/bin/gpg
[submodule]
	recurse = true

# ACA-specific aliases
[alias]
	aca-push = "!git push origin HEAD"
	aca-sync = "!git fetch origin && git rebase origin/main"
	work = "!echo 'Using ACA work configuration'"
